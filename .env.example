# ────────────────────────────────────────────────────────────────
# 사이(Sai) 환경 설정 — 복사해서 `.env` 로 저장한 뒤 값을 채우세요.
#   cp .env.example .env
# `.env` 는 절대 GitHub/zip 에 올리지 않습니다(.gitignore 에 포함).
# ────────────────────────────────────────────────────────────────

# Liner Platform API 키 (platform.liner.com → API Keys)
# 비워 두면 [데모 시드 모드]로 동작합니다 — 판정·근거·문서 흐름은 동일하고,
# 화면 배지만 [실시간 Liner API] ↔ [데모 시드 모드]로 구분됩니다.
LINER_API_KEY=

# Liner API 베이스 URL (기본값 그대로 두면 됩니다)
LINER_BASE_URL=https://platform.liner.com

# 문장 생성에 쓸 Router 모델과 라우팅 전략
#   모델: liner-gpt-router | liner-claude-router | liner-gemini-router
#   전략: cost(저렴) | balanced(기본) | quality(정확)
LINER_CHAT_MODEL=liner-gpt-router
LINER_ROUTING_LETTER=balanced
LINER_ROUTING_REPORT=cost

# 시드 모드 강제: auto(키 없으면 시드) | on(항상 시드) | off(항상 실호출)
SAI_DEMO_MODE=auto

# 시드 스트림 배속 (1.0 = 기본, 0.5 = 두 배 빠르게, 0 = 즉시)
SAI_STREAM_SPEED=1.0

# 서버 주소
SAI_HOST=127.0.0.1
SAI_PORT=8000
